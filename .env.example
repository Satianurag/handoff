# Local operator configuration only. Copy to ignored .env.local.
# Never copy this file into web/ or dist/ and never put real values in Git.

# Convex CLI writes CONVEX_DEPLOYMENT during project setup.
# Public-config precedence: process VITE_CONVEX_URL, then process CONVEX_URL,
# then CONVEX_URL from .env.local. Official Static Hosting supplies VITE_CONVEX_URL
# for the selected production deployment; do not override it with development.
# Production builds must explicitly target the production .convex.cloud URL.
CONVEX_URL=
AGENTMAIL_API_KEY=
FIRECRAWL_API_KEY=

# Current generation provider. Used server-side, not browser-side.
GENERATION_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=

# Configure server secrets separately in EACH Convex deployment, using --prod
# only when intentionally targeting production. Names below are not values.
# JWT_PRIVATE_KEY and JWKS: scripts/prepare-auth-env.mjs
# Model-only workload federation: scripts/configure-gemini-auth.mjs
# GEMINI_PROVIDER=vertex-federation
# GEMINI_AUTH_PRIVATE_KEY=
# GEMINI_AUTH_KEY_ID=
# GEMINI_AUTH_ISSUER=
# GEMINI_AUTH_AUDIENCE=
# GEMINI_AUTH_SUBJECT=
# AGENTMAIL_WEBHOOK_SECRET= (scripts/configure-agentmail-webhook.mjs)
# SITE_URL= (public frontend origin for auth/notification links)

# Optional source-text adapter only; NOT currently verified runtime usage.
# Changing provider requires explicit configuration and reevaluation.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GENERATION_PROVIDER=openai
# Original PDF/image extraction remains Gemini-specific.
